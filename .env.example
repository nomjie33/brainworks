# Copy to .env.local for local development. Never commit real values.

# Local Postgres from `docker compose up -d`. In Vercel this is injected by the Neon integration.
DATABASE_URL=postgresql://brainworks:brainworks@localhost:5432/brainworks

# Sentry (optional locally; leave empty to disable)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps during builds (set in Vercel, not locally)
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Feature flags: "true" or "false" (default false)
FLAG_PUBLIC_ENROLLMENT=false
FLAG_TUTOR_PORTAL=false
FLAG_ADMIN_PORTAL=false
